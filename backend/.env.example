# MongoDB connection string — shared team cluster URI, ask whoever set up Atlas
MONGO_URI=mongodb://localhost:27017

# Path to the Google Cloud Vision service account JSON key file
# Do NOT commit the actual key file — keep it outside git or gitignore it by filename
GOOGLE_VISION_KEY_PATH=./secrets/gcp-vision-key.json

# LLM API key (Claude/Anthropic or whichever provider is finalized)
LLM_API_KEY=

# Whisper API key (if using OpenAI's hosted Whisper endpoint)
WHISPER_API_KEY=

# JWT for role-based auth
JWT_SECRET_KEY=paste-a-generated-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
